# Copy to .env and adjust per environment (e.g. on a remote server, use its public IP/domain).
# docker-compose.yml reads this file automatically for local (non-docker) dev, every
# workspace (api/web/db) loads its vars from THIS single root file — no more per-package
# .env files. See root package.json scripts (dotenv-cli / bun --env-file) for how each
# workspace picks this up.

# Base URL the browser uses to reach the API — must include the /api prefix.
# Baked into the web app's JS bundle at Docker build time, so changing this
# requires `docker compose build web` (not just a container restart).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api

# Origin ที่อนุญาตให้เรียก API ผ่าน CORS — ต้องตรงกับ origin จริงที่ web app รันอยู่ (ไม่มี trailing slash)
CORS_ORIGIN=http://localhost:3001

DATABASE_URL="postgresql://loop:loop@localhost:5433/loop?schema=public"
DIRECT_URL="postgresql://loop:loop@localhost:5433/loop?schema=public"
JWT_SECRET="change-me"
PORT=4001

DB_PASSWORD=loop
DB_USER=loop

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o
EMBEDDING_MODEL=openai/text-embedding-3-large