{
  "name": "loop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "dotenv -e .env -- npm run dev --workspace=apps/web",
    "build": "dotenv -e .env -- npm run build --workspace=packages/db && npm run build --workspace=apps/api && dotenv -e .env -- npm run build --workspace=apps/web",
    "db": "dotenv -e .env -- npm run build --workspace=packages/db",
    "seed": "dotenv -e .env -- npm run seed --workspace=packages/db",
    "prisma": "dotenv -e .env -- prisma --schema=packages/db/prisma/schema.prisma",
    "generate": "dotenv -e .env -- prisma generate --schema=packages/db/prisma/schema.prisma",
    "migrate": "dotenv -e .env -- prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "migrate:deploy": "dotenv -e .env -- prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:push": "dotenv -e .env -- prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:pull": "dotenv -e .env -- prisma db pull --schema=packages/db/prisma/schema.prisma",
    "test": "npm run test --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
