generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Role เป็น table ไม่ใช่ enum — เพื่อให้ admin สร้าง role ใหม่ได้
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // admin, user
  label       String // ผู้ดูแลระบบ, ผู้ใช้ทั่วไป
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuKey   String // "dashboard" | "categories" | "users" | "products" | "payments" | "settings"
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([roleId, menuKey])
}

enum AccountType {
  INDIVIDUAL
  SHOP
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  passwordHash       String
  phone              String
  lineId             String?
  accountType        AccountType        @default(INDIVIDUAL)
  roleId             Int
  role               Role               @relation(fields: [roleId], references: [id])
  verificationStatus VerificationStatus @default(PENDING) // PENDING = ระหว่างรอยืนยัน OTP เท่านั้น, APPROVED ตั้งอัตโนมัติทันทีที่ OTP ผ่าน (ดู Phase 3)
  idCardImageUrl     String? // อัปโหลดตอน signup KYC
  faceVerified       Boolean            @default(false)
  legalName          String? // ชื่อ-นามสกุลจริงตามบัญชีธนาคาร ใช้เทียบกับชื่อผู้รับในสลิป (Phase 10) — คนละฟิลด์กับ name ที่เป็นชื่อแสดงในระบบ
  promptPayQrUrl     String? // รูป QR พร้อมเพย์ที่เจ้าของอัปโหลดเอง (Phase 10)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  deletedAt          DateTime?

  otpCodeHash   String? // bcrypt hash ของรหัส OTP ปัจจุบัน (null = ไม่มี OTP ค้างอยู่)
  otpExpiresAt  DateTime?
  otpMethod     String? // "email" | "phone"
  otpVerifiedAt DateTime? // null = ยังไม่เคยยืนยันตัวตนผ่าน OTP

  products          Product[]      @relation("ProductOwner")
  locations         UserLocation[]
  createdCategories Category[]     @relation("CategoryCreatedBy")
  updatedCategories Category[]     @relation("CategoryUpdatedBy")
  createdProducts   Product[]      @relation("ProductCreatedBy")
  updatedProducts   Product[]      @relation("ProductUpdatedBy")
  rentalsAsRenter   Rental[]       @relation("RentalRenter")
  rentalsAsOwner    Rental[]       @relation("RentalOwner")
}

// สถานที่นัดรับที่ผู้ใช้บันทึกไว้ (ปักหมุดบนแผนที่ครั้งเดียว เลือกซ้ำได้ตอนลงประกาศใหม่)
model UserLocation {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // ชื่อเรียกสั้นๆ เช่น "บ้าน", "ที่ทำงาน"
  address   String // ข้อความที่อยู่ (จาก reverse-geocode หรือกรอกเอง)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  products    Product[]
}

enum ProductStatus {
  UNDER_REVIEW // เพิ่งลงประกาศ รอแอดมิน/ระบบตรวจสอบ
  ACTIVE
  PAUSED
}

model Product {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  ownerId     Int
  owner       User          @relation("ProductOwner", fields: [ownerId], references: [id])
  pricePerDay Decimal
  price3Day   Decimal? // ราคาขั้นบันได optional — ดู Dev Standard #21 (resolveRentPrice, ปัดขึ้น tier ถัดไปเสมอ)
  price7Day   Decimal?
  location    String
  lat         Float? // พิกัดจากแผนที่ (optional — ประกาศเดิมก่อนมี map ยังไม่มีค่า)
  lng         Float?
  status      ProductStatus @default(UNDER_REVIEW)
  ratingAvg   Float         @default(0) // cache — คำนวณจาก Review ตอน create/update review (ยังไม่มี Review model)
  reviewCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?         @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  images        ProductImage[]
  pickupOptions PickupOption[]
  rentals       Rental[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

enum PickupMethod {
  MEETUP // นัดรับ — label คือจุดนัดรับที่เจ้าของกำหนดเอง มีได้หลายจุด
  GRAB // จัดส่งผ่าน Grab — toggle เดียวต่อประกาศ
  POST // จัดส่งทางไปรษณีย์ — toggle เดียวต่อประกาศ
}

model PickupOption {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      PickupMethod @default(MEETUP)
  label     String
  createdAt DateTime     @default(now())
}

// Phase 10 — เวอร์ชันขั้นต่ำ แค่พอให้มี "คำขอเช่า + ราคารวม + สถานะจ่ายเงิน" ให้หน้าจ่ายเงินอ้างอิงได้
// ยังไม่ใช่ full lifecycle (pending→approved→shipped→completed) ตาม Scope ต้นเอกสาร
enum RentalStatus {
  PENDING_PAYMENT
  PAID
  REJECTED
}

model Rental {
  id              Int          @id @default(autoincrement())
  productId       Int
  product         Product      @relation(fields: [productId], references: [id])
  renterId        Int
  renter          User         @relation("RentalRenter", fields: [renterId], references: [id])
  ownerId         Int // denormalize จาก product.ownerId ตอนสร้าง (Dev Standard #19 pattern)
  owner           User         @relation("RentalOwner", fields: [ownerId], references: [id])
  startDate       DateTime
  endDate         DateTime
  nights          Int
  pricePerDaySnap Decimal
  totalAmount     Decimal
  status          RentalStatus @default(PENDING_PAYMENT)
  createdAt       DateTime     @default(now())

  paymentSlips PaymentSlip[]
}

// เก็บทุกครั้งที่อัปโหลดสลิป (ผ่าน/ไม่ผ่านก็เก็บ) เป็น audit log — rentalId ไม่ unique เพราะอัปโหลดใหม่ได้ถ้าครั้งก่อนไม่ผ่าน
// reference unique (global) คือตัวกัน replay จริง — ห้ามใช้สลิปใบเดิมซ้ำข้าม rental
model PaymentSlip {
  id             Int      @id @default(autoincrement())
  rentalId       Int
  rental         Rental   @relation(fields: [rentalId], references: [id])
  imageUrl       String
  amount         Decimal
  transferredAt  DateTime
  reference      String   @unique
  senderName     String?
  receiverName   String?
  bank           String?
  verified       Boolean  @default(false)
  rejectedReason String?
  rawAnalysis    String // JSON.stringify ของผลดิบจาก AI เก็บไว้ debug/audit
  createdAt      DateTime @default(now())
}
